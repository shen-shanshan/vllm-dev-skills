# Run on the HOST. Starts a long-lived ROCm container; scripts 02/03 run inside it.
# Env vars deliberately live in 02_start_server.sh / 03_run_client.sh, not here.
set -euo pipefail

%%SCRIPT_DIR_VAR%%

CONTAINER_NAME="%%CONTAINER_NAME%%"
IMAGE="%%IMAGE%%"

# ---- mounts (host -> container) ----
%%MOUNT_NOTES%%

