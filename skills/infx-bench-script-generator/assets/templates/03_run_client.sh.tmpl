#!/usr/bin/env bash
# Generated by infx-bench-script-generator for %%RECIPE_NAME%% :: %%OVERRIDE%%
# Run INSIDE the container (after 02_start_server.sh reports ready):
#   docker exec -it %%CONTAINER_NAME%% bash /infx-scripts/03_run_client.sh
# Runs the AgentX trace replay (InferenceX benchmarks/srt_agentic.sh) against the local server.
set -e

WORKSPACE="/infmax-workspace"
REPO_URL="https://github.com/SemiAnalysisAI/InferenceX"

# ---- InferenceX checkout (host path mounted read-only normally; clone fallback) ----
if [[ ! -f "$WORKSPACE/inferencex-e2e/benchmarks/srt_agentic.sh" ]]; then
    echo "InferenceX checkout missing at $WORKSPACE; cloning ..."
    git clone --recurse-submodules "$REPO_URL" "$WORKSPACE"
fi
if [[ ! -d "$WORKSPACE/inferencex-e2e/utils/aiperf/src" ]]; then
    echo "ERROR: utils/aiperf submodule missing; run: git -C $WORKSPACE submodule update --init --recursive" >&2
    exit 1
fi

export INFMAX_CONTAINER_WORKSPACE="$WORKSPACE"

# ---- agentic mode first: clears MAX_MODEL_LEN so no --max-context-length is passed ----
export IS_AGENTIC=1
export SCENARIO_TYPE=agentic-coding
export KV_OFFLOADING=none

# ---- InferenceX client defaults, then local overrides ----
source "$WORKSPACE/inferencex-e2e/benchmarks/runtime_settings.sh"
export ENABLE_AGENTX_POWER=0
export REQUIRE_POWER=0
export AIPERF_EXPERIMENTAL_FAST=0
export IS_MULTINODE=false

# ---- required client inputs ----
export MODEL="%%MODEL_ID%%"
export MODEL_PREFIX="%%MODEL_PREFIX%%"
export FRAMEWORK="%%FRAMEWORK%%"
export PRECISION="%%PRECISION%%"
export SERVED_MODEL_NAME="%%SERVED_MODEL_NAME%%"
export CONC="%%CONC%%"
export DURATION="${DURATION:-3600}"
export RESULT_FILENAME="%%RESULT_FILENAME%%"
export RESULT_DIR="/logs/agentic"
export AGENTIC_OUTPUT_DIR="/logs"
export EVAL_ONLY=false
export PORT="8000"
# tp8 hits the engine directly; dep8 hits the vllm-router frontend (port 30000).
export AIPERF_SERVER_URL="http://localhost:%%CLIENT_PORT%%"
# The router does not re-export engine metrics; always scrape the engine directly.
export AIPERF_SERVER_METRICS_URLS="http://localhost:8000/metrics"
export HF_HUB_CACHE="/hf-cache"

# ---- recipe benchmark.env passthrough (CONC/HTTP timeouts/metric prefix/session-id) ----
%%BENCHMARK_ENV_EXPORTS%%

mkdir -p "$RESULT_DIR"

%%PROFILER_START_BLOCK%%

echo "Running AgentX replay: MODEL=$MODEL CONC=$CONC DURATION=$DURATION"
bash "$WORKSPACE/inferencex-e2e/benchmarks/srt_agentic.sh"

%%PROFILER_STOP_BLOCK%%

cat <<EOF
Done. Results:
  aggregate:   /logs/$RESULT_FILENAME.json
  raw replay:  /logs/agentic/aiperf_artifacts/
  server log:  /logs/server.log
  traces:      /logs/traces/   (only when profiling was requested)
EOF
