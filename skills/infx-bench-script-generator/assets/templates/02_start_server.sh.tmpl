#!/usr/bin/env bash
# Generated by infx-bench-script-generator for %%RECIPE_NAME%% :: %%OVERRIDE%%
# Run INSIDE the container: docker exec -it %%CONTAINER_NAME%% bash /infx-scripts/02_start_server.sh
set -euo pipefail

MODEL_ID="%%MODEL_ID%%"
MODEL_DIR="/model"
LOGS_DIR="/logs"
HF_CACHE="/hf-cache"
ENGINE_PORT=8000

# ---- env from recipe roles.agg.env / frontend.env ----
export HF_HOME="$HF_CACHE"
export HF_HUB_CACHE="$HF_CACHE"
%%ENGINE_ENV_EXPORTS%%

# HF token for gated checkpoints (host ~/.cache/huggingface is mounted at /hf-cache by default)
if [[ -z "${HF_TOKEN:-}" && -f "$HF_CACHE/token" ]]; then
    export HF_TOKEN="$(cat "$HF_CACHE/token")"
fi

# ---- runtime python deps the nightly image lacks (recipe SETUP_PIP_PACKAGES) ----
%%PIP_INSTALL_BLOCK%%

# ---- model weights: download once when no host path was mounted ----
if [[ ! -f "$MODEL_DIR/config.json" ]]; then
    if [[ -z "${HF_TOKEN:-}" ]]; then
        echo "ERROR: /model is empty and no HF token found; gated checkpoints need $HF_CACHE/token or HF_TOKEN" >&2
        exit 1
    fi
    echo "Downloading $MODEL_ID (revision %%MODEL_REVISION%%) to $MODEL_DIR ..."
    huggingface-cli download "$MODEL_ID" --revision "%%MODEL_REVISION%%" --local-dir "$MODEL_DIR"
fi

mkdir -p "$LOGS_DIR/traces"

# ---- start vllm serve (args from roles.agg.args of the selected variant) ----
echo "Starting vllm serve ... (log: $LOGS_DIR/server.log)"
nohup vllm serve "$MODEL_DIR" \
%%SERVER_ARGS%% \
  > "$LOGS_DIR/server.log" 2>&1 &
echo "vllm serve started (pid $!)"

# ---- wait for engine ready (cold loads of large checkpoints can take hours) ----
ready_timeout="${VLLM_ENGINE_READY_TIMEOUT_S:-10800}"
deadline=$(( $(date +%s) + ready_timeout ))
until curl -fsS "http://localhost:${ENGINE_PORT}/health" >/dev/null 2>&1; do
    if (( $(date +%s) > deadline )); then
        echo "ERROR: vllm not ready within ${ready_timeout}s; see $LOGS_DIR/server.log" >&2
        tail -50 "$LOGS_DIR/server.log" >&2 || true
        exit 1
    fi
    sleep 10
done
echo "Engine ready at http://localhost:${ENGINE_PORT}"

%%ROUTER_BLOCK%%

echo "Server ready. Next: docker exec %%CONTAINER_NAME%% bash /infx-scripts/03_run_client.sh"
